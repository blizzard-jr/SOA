  "components": {
    "schemas": {
      "Coordinates": {
        "required": [
          "x",
          "y"
        ],
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "format": "float"
          },
          "y": {
            "type": "number",
            "format": "float",
            "nullable": false
          }
        }
      },
      "Input": {
        "required": [
          "coordinates",
          "expelledStudents",
          "formOfEducation",
          "name",
          "studentsCount"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Непустая строка, не только пробелы"
          },
          "coordinates": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "studentsCount": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "expelledStudents": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "shouldBeExpelled": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "formOfEducation": {
            "type": "string",
            "enum": [
              "DISTANCE_EDUCATION",
              "FULL_TIME_EDUCATION",
              "EVENING_CLASSES"
            ]
          },
          "groupAdmin": {
            "$ref": "#/components/schemas/Person",
            "nullable": true
          }
        },
        "description": "Изменяемые данные группы для POST и PUT."
      },
      "Location": {
        "required": [
          "name",
          "x",
          "y",
          "z"
        ],
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "format": "int64"
          },
          "y": {
            "type": "integer",
            "format": "int32"
          },
          "z": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "maxLength": 792,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "Person": {
        "required": [
          "location",
          "name",
          "weight"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Непустая строка, не только пробелы"
          },
          "weight": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "eyeColor": {
            "type": "string",
            "enum": [
              "GREEN",
              "RED",
              "BROWN"
            ],
            "nullable": true
          },
          "hairColor": {
            "type": "string",
            "enum": [
              "GREEN",
              "RED",
              "ORANGE",
              "BROWN"
            ],
            "nullable": true
          },
          "nationality": {
            "type": "string",
            "enum": [
              "UNITED_KINGDOM",
              "INDIA",
              "VATICAN",
              "SOUTH_KOREA"
            ],
            "nullable": true
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          }
        }
      },
      "StudyGroup": {
        "required": [
          "coordinates",
          "creationDate",
          "expelledStudents",
          "formOfEducation",
          "id",
          "name",
          "studentsCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "readOnly": true
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Непустая строка, не только пробелы"
          },
          "coordinates": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "creationDate": {
            "type": "string",
            "format": "date",
            "readOnly": true
          },
          "studentsCount": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "expelledStudents": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "shouldBeExpelled": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "formOfEducation": {
            "type": "string",
            "enum": [
              "DISTANCE_EDUCATION",
              "FULL_TIME_EDUCATION",
              "EVENING_CLASSES"
            ]
          },
          "groupAdmin": {
            "$ref": "#/components/schemas/Person",
            "nullable": true
          }
        },
        "description": "Учебная группа с автоматически назначенными ID и датой создания."
