            "type": "string",
            "format": "date"
          },
          "count": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Average": {
        "type": "object",
        "properties": {
          "average": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "Единое JSON-тело ошибки, формируемое ApiExceptionHandler.",
        "required": [
          "timestamp",
          "status",
          "error",
          "path"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 400,
